---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';
---

<Layout
  title="About"
  description="About this interdisciplinary art and maker portfolio."
>
  <article class="page prose">
    <h1 class="page__title" data-i18n="about">About</h1>

    <p class="lede" data-i18n="aboutIntro">
      This portfolio is dedicated to my artistic work, including explorations in maker culture and documentation of creative processes.
    </p>

    <p data-i18n="aboutWork">
      I have explored different artistic languages and techniques from an early age, and my interests span many different fields. This website — both a blog and an art portfolio — brings those interests together.
    </p>

    <h2 data-i18n="aboutExplore">Explore the site</h2>

    <p>
      <a href={withBase('/')} data-i18n="aboutArtLink">Art</a>
      <span data-i18n="aboutArtDescription">
      brings together artistic works, whether finished or unfinished.
    </span>
    </p>

    <p>
      <a href={withBase('/maker')} data-i18n="aboutMakerLink">Maker</a>
      <span data-i18n="aboutMakerDescription">
      explores broader projects that extend beyond the previous category.
    </span>
    </p>

    <p>
      <a href={withBase('/project-blog')} data-i18n="aboutProjectLink">Project Blog</a>
      <span data-i18n="aboutProjectDescription">
      is a section dedicated to WIPs (works in progress) and artistic processes.
    </span>
    </p>

    <p>
      <a href={withBase('/commonplace-blog')} data-i18n="aboutCommonplaceLink">Commonplace Blog</a>
      <span data-i18n="aboutCommonplaceDescription">
      is something more personal and, in a way, universal as well. It is where I gather my experiences, impressions, techniques, and references.
    </span>
    </p>

    <p>
      <span data-i18n="aboutContactIntro">
      For inquiries and other communications, visit
    </span>
      <a href={withBase('/contact')} data-i18n="aboutContactLink">Contact</a>.
    </p>
  </article>
</Layout>
