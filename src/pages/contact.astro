---
import { withBase } from '../utils/paths';
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { social } from "../config";

const links = [
    {
        name: "instagram" as const,
        label: "Instagram",
        handle: "@tech.master.3d",
        href: social.instagram,
    },
    {
        name: "github" as const,
        label: "GitHub",
        handle: "@sinsidev",
        href: social.github,
    },
].filter(link => Boolean(link.href));
---

<Layout
    title="Contact"
    description="Ways to follow new work and get in touch."
>
    <article class="page prose">
        <h1 class="page__title" data-i18n="contactTitle">Contact</h1>
        <p class="lede" data-i18n="contactIntro">The best way to follow new work or get in touch:</p>




        <ul class="contact-list">
            {
                links.map((link) => (
                    <li>
                        <a
                            class="contact-card"
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <span class="contact-card__icon">
                                <Icon name={link.name} />
                            </span>
                            <span class="contact-card__text">
                                <span class="contact-card__label">
                                    {link.label}
                                </span>
                                <span class="contact-card__handle">
                                    {link.handle}
                                </span>
                            </span>
                            <span
                                class="contact-card__arrow"
                                aria-hidden="true"
                            >
                                →
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <section class="contact-form">
            <h2 data-i18n="contactFormTitle">Send a message</h2>
            <p data-i18n="contactFormDescription">
                For inquiries, commissions, or collaborations,
                use the form below.
            </p>

            <iframe
                title="Contact form"
                src="https://docs.google.com/forms/d/e/1FAIpQLSejsPunJazXMxL0X0P79tdGoXWNrZM2RMolODwoKRtnYLWlDQ/viewform?embedded=true"
                width="640"
                height="918"
                loading="lazy"
            ></iframe>

            <p>
                <span data-i18n="contactFormHelp">Having trouble with the form?</span>
                <a
                    href="https://docs.google.com/forms/d/e/1FAIpQLSejsPunJazXMxL0X0P79tdGoXWNrZM2RMolODwoKRtnYLWlDQ/viewform"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span data-i18n="contactFormOpen">Open it in a new tab</span>
                </a>.
            </p>
        </section>

        <p>
            <a class="text-link" href={withBase('/license')}><span data-i18n="contactLicense">Image Usage and Licensing →</span></a>
        </p>
        <p>
            <a class="text-link" href={withBase('/privacy')}><span data-i18n="contactPrivacy">Privacy Policy →</span></a>
        </p>
    </article>
</Layout>

<style>
  .contact-form {
    margin: 2rem 0;
  }

  .contact-form iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    min-height: 918px;
    border: 0;
    border-radius: 8px;
  }
</style>
