---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import CoverImage from '../../components/CoverImage.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection(
    'projectBlog',
    ({ data }) => !data.draft
  );

  return posts.map((post) => ({
    params: {
      slug: post.id.replace(/\.(md|mdx)$/, ''),
    },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'projectBlog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const {
  title,
  description,
  pubDate,
  updatedDate,
  project,
  tags,
  cover,
  coverAlt,
} = post.data;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Layout title={title} description={description ?? title}>
  <article class="page prose">
    <header>
      <h1 class="page__title">{title}</h1>

      {description && <p class="lede">{description}</p>}

      <p>
        <time datetime={pubDate.toISOString()} data-i18n-date>
          {formatDate(pubDate)}
        </time>
      </p>

      <p><strong data-i18n="postProject">Project:</strong> {project}</p>

      {updatedDate && (
        <p>
          <span data-i18n="postUpdated">Updated:</span>
          <time datetime={updatedDate.toISOString()} data-i18n-date>
            {formatDate(updatedDate)}
          </time>
        </p>
      )}

      {tags.length > 0 && (
        <p><strong data-i18n="postTags">Tags:</strong> {tags.join(' · ')}</p>
      )}
    </header>

    {cover && (
      <CoverImage
        src={cover}
        alt={coverAlt || title}
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 768px) 100vw, 900px"
        style="width: 100%; height: auto;"
      />
    )}

    <Content />
  </article>
</Layout>
