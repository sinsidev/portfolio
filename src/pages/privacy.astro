---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';
---

<Layout
  title="Privacy"
  description="Privacy information for visitors to this website."
>
  <article class="page prose">
    <h1 class="page__title" data-i18n="privacyTitle">Privacy Policy</h1>

    <p class="lede" data-i18n="privacyIntro">
      This website is a personal portfolio for artwork, creative projects, and writing.
    </p>

    <h2 data-i18n="privacyHostingTitle">Website hosting</h2>
    <p data-i18n="privacyHostingText">
      This website is hosted using GitHub Pages. The hosting provider may process technical information, such as IP addresses and request logs, to deliver and maintain the service.
    </p>

    <h2 data-i18n="privacyPreferencesTitle">Local preferences</h2>
    <p data-i18n="privacyPreferencesText">
      The website may store your selected language and color theme in your browser's local storage.
    </p>

    <h2 data-i18n="privacyFormTitle">Contact Form</h2>
    <p data-i18n="privacyFormText">
      The Contact page includes a form provided by Google Forms. When you submit a message, the information you provide, such as your name, email address, and message, is processed by Google and made available to the website owner for responding to your inquiry.
    </p>

    <p>
      <span data-i18n="privacyGoogleIntro">
        The embedded form may also process technical information according to Google's privacy practices. Please refer to
      </span>
      <a
        href="https://policies.google.com/privacy"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="privacyGoogleLink"
      >Google's Privacy Policy</a>
      <span data-i18n="privacyGoogleEnd">for further information.</span>
    </p>

    <h2 data-i18n="privacyExternalTitle">External websites</h2>
    <p data-i18n="privacyExternalText">
      Links to external platforms and social networks are provided for convenience. These services operate under their own privacy policies.
    </p>

    <h2 data-i18n="privacyContactTitle">Contact</h2>
    <p>
      <span data-i18n="privacyContactIntro">
        For questions about this website and its privacy practices, please visit the
      </span>
      <a href={withBase('/contact')} data-i18n="privacyContactLink">Contact</a>
      <span data-i18n="privacyContactEnd">page.</span>
    </p>
  </article>
</Layout>
