---
import Layout from '../../layouts/Layout.astro';
import EditorialPostList from '../../components/EditorialPostList.astro';
import EditorialTagFilters from '../../components/EditorialTagFilters.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection(
  'projectBlog',
  ({ data }) => !data.draft
)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);


---

<Layout
  title="Project Blog"
  description="Development journals, creative processes, and project updates."
>
  <section class="page prose project-blog">
    <h1 class="page__title" data-i18n="projectBlog">Project Blog</h1>

    <EditorialTagFilters
      tags={posts.flatMap(post => post.data.tags)}
    />

    <EditorialPostList
      section="project-blog"
      posts={posts.map(post => ({
        id: post.id,
        title: post.data.title,
        description: post.data.description,
        pubDate: post.data.pubDate,
        tags: post.data.tags,
        cover: post.data.cover,
        coverAlt: post.data.coverAlt,
        project: post.data.project,
      }))}
    />

    {posts.length === 0 && (
      <p data-i18n="projectBlogEmpty">No project updates yet.</p>
    )}
  </section>
</Layout>
