---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Project Blog"
  description="Development journals, creative processes, and project updates."
>
  <main class="page prose">
    <h1 class="page__title">Project Blog</h1>

    <p class="lede">
      Notes on projects, experiments, and works in progress.
    </p>

    <p>
      A chronological journal documenting creative and technical
      projects, from early ideas and experiments to finished work.
    </p>

    <p>
      Entries will also be grouped by project, making it possible
      to follow each project's development over time.
    </p>
  </main>
</Layout>
