---
import Layout from '../../layouts/Layout.astro';
import EditorialPostList from '../../components/EditorialPostList.astro';
import EditorialTagFilters from '../../components/EditorialTagFilters.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection(
  'commonplaceBlog',
  ({ data }) => !data.draft
)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);


---

<Layout title="Commonplace Blog">
  <section class="page prose">
    <h1 class="page__title" data-i18n="commonplaceBlog">Commonplace Blog</h1>

    <EditorialTagFilters
      tags={notes.flatMap(note => note.data.tags)}
    />

    <EditorialPostList
      section="commonplace-blog"
      posts={notes.map(note => ({
        id: note.id,
        title: note.data.title,
        description: note.data.description,
        pubDate: note.data.pubDate,
        tags: note.data.tags,
        cover: note.data.cover,
        coverAlt: note.data.coverAlt,
      }))}
    />

  </section>
</Layout>
