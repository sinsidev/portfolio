---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Commonplace Blog"
  description="A collection of notes, ideas, references, and discoveries."
>
  <main class="page prose">
    <h1 class="page__title">Commonplace Blog</h1>

    <p class="lede">
      A place for collecting thoughts, ideas, and discoveries.
    </p>

    <p>
      Notes on art, books, techniques, references, and subjects
      worth exploring.
    </p>

    <p>
      Entries will be organized chronologically, with filters
      by topic and connections between related notes.
    </p>
  </main>
</Layout>
