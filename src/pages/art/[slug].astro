---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import CoverImage from '../../components/CoverImage.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const artworks = await getCollection('art', ({ data }) => !data.draft);

  return artworks.map((artwork) => ({
    params: { slug: artwork.id.replace(/\.(md|mdx)$/, '') },
    props: { artwork },
  }));
}

interface Props {
  artwork: CollectionEntry<'art'>;
}

const { artwork } = Astro.props;
const { Content } = await render(artwork);
const { title, description, cover, coverAlt, categories, year, materials, techniques } =
  artwork.data;
---

<Layout title={title} description={description ?? title}>
  <article class="page prose">
    <header>
      <h1 class="page__title">{title}</h1>

      {description && <p class="lede">{description}</p>}

      <p>
        {categories.map((category, i) => (
          <>
            {i > 0 && ' · '}
            <span data-i18n={`artCategory${category.replace(/[^a-zA-Z0-9]/g, '')}`}>
              {category}
            </span>
          </>
        ))}
        {year && ` · ${year}`}
      </p>
    </header>

    <CoverImage
      src={cover}
      alt={coverAlt || title}
      widths={[480, 800, 1200, 1600]}
      sizes="(max-width: 768px) 100vw, 900px"
      style="width: 100%; height: auto;"
    />

    <Content />

    {(materials.length > 0 || techniques.length > 0) && (
      <footer>
        {materials.length > 0 && (
          <p><strong data-i18n="detailMaterials">Materials:</strong> {materials.join(', ')}</p>
        )}
        {techniques.length > 0 && (
          <p><strong data-i18n="detailTechniques">Techniques:</strong> {techniques.join(', ')}</p>
        )}
      </footer>
    )}
  </article>
</Layout>
