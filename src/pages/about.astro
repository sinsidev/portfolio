---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';
---

<Layout
  title="About"
  description="About this interdisciplinary art and maker portfolio."
>
  <article class="page prose">
    <h1 class="page__title" data-i18n="about">About</h1>

    <p class="lede" data-i18n="aboutIntro">
      This is a space for art, making, experimentation, and documenting creative processes.
    </p>

    <p data-i18n="aboutWork">
      My work moves between visual art, digital tools, physical fabrication, and creative research.
      This website brings those interests together.
    </p>

    <h2 data-i18n="aboutExplore">Explore the site</h2>

    <p>
      <a href={withBase('/')} data-i18n="aboutArtLink">Art</a>
      <span data-i18n="aboutArtDescription">
        is a collection of artwork, visual studies, and experiments.
      </span>
    </p>

    <p>
      <a href={withBase('/maker')} data-i18n="aboutMakerLink">Maker</a>
      <span data-i18n="aboutMakerDescription">
        explores physical projects, fabrication, and making.
      </span>
    </p>

    <p>
      <a href={withBase('/project-blog')} data-i18n="aboutProjectLink">Project Blog</a>
      <span data-i18n="aboutProjectDescription">
        documents projects as they develop, including experiments, decisions, and results.
      </span>
    </p>

    <p>
      <a href={withBase('/commonplace-blog')} data-i18n="aboutCommonplaceLink">Commonplace Blog</a>
      <span data-i18n="aboutCommonplaceDescription">
        collects notes, references, techniques, and ideas connected through shared topics.
      </span>
    </p>

    <p>
      <span data-i18n="aboutContactIntro">For inquiries and links, visit</span>
      <a href={withBase('/contact')} data-i18n="aboutContactLink">Contact</a>.
    </p>
  </article>
</Layout>
