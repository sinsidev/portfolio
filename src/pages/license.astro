---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';
import { site } from '../config';
---

<Layout
  title="Copyright & Usage"
  description="Copyright and usage information for artwork, projects, images, and writing."
>
  <article class="page prose">
    <h1 class="page__title" data-i18n="licenseTitle">Copyright & Usage</h1>

    <p class="lede" data-i18n="licenseIntro">
      Unless otherwise stated, original content published on this website is protected by copyright. All rights reserved.
    </p>

    <h2 data-i18n="licenseOriginalTitle">Original work</h2>

    <p>
      <span data-i18n="licenseOriginalPrefix">
        Artwork, illustrations, photographs, 3D creations, project documentation, and written content created by
      </span>
      {site.name}
      <span data-i18n="licenseOriginalSuffix">
        are protected by copyright.
      </span>
    </p>

    <p data-i18n="licensePersonalUse">
      You are welcome to view this content for personal reference and enjoyment.
    </p>

    <h2 data-i18n="licensePermissionsTitle">Permissions</h2>

    <p data-i18n="licensePermissionsText">
      Reproduction, redistribution, modification, publication, and commercial use require prior permission unless explicitly authorized.
    </p>

    <h2 data-i18n="licenseExceptionsTitle">
      Exceptions and third-party materials
    </h2>

    <p data-i18n="licenseExceptionsText">
      Some projects may contain third-party materials, collaborative contributions, or content subject to separate licenses or agreements.
    </p>

    <p data-i18n="licenseConditionsText">
      Where specific usage conditions are provided, those conditions take precedence over the general policy on this page.
    </p>

    <h2 data-i18n="licenseThirdPartyTitle">Third-Party Materials</h2>

    <p data-i18n="licenseThirdPartyText">
      This website may include third-party materials, such as visual references,
      photographs, artwork, and other resources used in studies, research,
      or projects. Rights to these materials remain with their respective holders.
    </p>

    <p data-i18n="licenseThirdPartyCredits">
      Where applicable, authorship and source links are provided in the
      captions of individual images. The general copyright policy of this
      website does not grant permission to reuse third-party materials.
    </p>

    <h2 data-i18n="licenseContactTitle">Contact</h2>

    <p>
      <span data-i18n="licenseContactIntro">
        For permission requests or licensing inquiries, please visit the
      </span>
      <a href={withBase('/contact')} data-i18n="licenseContactLink">Contact</a>
      <span data-i18n="licenseContactEnd">page.</span>
    </p>
  </article>
</Layout>
