---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths?: number[];
  sizes?: string;
  width?: number;
  height?: number;
  fit?: 'cover' | 'contain' | 'fill' | 'none' | 'scale-down';
  loading?: 'lazy' | 'eager';
  class?: string;
  style?: string;
}

const {
  src,
  alt,
  widths,
  sizes,
  width,
  height,
  fit,
  loading = 'lazy',
  class: className,
  style,
} = Astro.props;

const external = typeof src === 'string';
---

{external ? (
  <img
    src={src}
    alt={alt}
    loading={loading}
    decoding="async"
    class={className}
    style={style}
    width={width}
    height={height}
  />
) : (
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    width={width}
    height={height}
    fit={fit}
    loading={loading}
    class={className}
    style={style}
  />
)}
