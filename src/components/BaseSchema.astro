---
import { site, social } from '../config';
import { withBase } from '../utils/paths';

// Structured data for the website and its creator.
const absoluteUrl = (path: string) =>
  Astro.site
    ? new URL(withBase(path), Astro.site).href
    : withBase(path);

const home = absoluteUrl('/');
const websiteId = `${home}#website`;
const personId = `${home}#person`;

const sameAs = [
  social.github,
  social.instagram,
].filter((url): url is string => Boolean(url));

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: home,
      name: site.title,
      description: site.description,
      inLanguage: ['en', 'pt-BR'],
      publisher: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      url: home,
      jobTitle: 'Visual Artist',
      sameAs,
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
